{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Zebar settings",
  "description": "General settings for Zebar.",
  "type": "object",
  "required": ["startupConfigs"],
  "properties": {
    "startupConfigs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pack": {
            "type": "string"
          },
          "widget": {
            "type": "string"
          },
          "preset": {
            "type": "string"
          }
        },
        "required": ["pack", "widget", "preset"]
      }
    },
    "acceptFirstMouse": {
      "type": "boolean",
      "default": false,
      "description": "Whether clicking an unfocused widget also clicks through to the widget, instead of only focusing its window. Only has an effect on macOS, and applies to widgets opened after the setting changes."
    }
  }
}

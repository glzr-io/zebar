{
  "name": "zebar-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "crates/*"
  ],
  "scripts": {
    "build": "pnpm run -r build",
    "dev": "pnpm run --filter zebar build && pnpm run --parallel dev",
    "dev:local": "pnpm run --filter zebar build && pnpm run --parallel dev:local",
    "format:check": "pnpm rust:format:check && pnpm js:format:check",
    "format:fix": "pnpm rust:format:fix && pnpm js:format:fix",
    "js:format:check": "prettier --check .",
    "js:format:fix": "prettier --write .",
    "lint:check": "pnpm -r lint:check",
    "lint:fix": "pnpm -r lint:fix",
    "rust:format:check": "cargo fmt --check",
    "rust:format:fix": "cargo fmt"
  },
  "prettier": "@glzr/style-guide/prettier",
  "dependencies": {},
  "devDependencies": {
    "@glzr/style-guide": "1.1.0",
    "prettier": "3.2.5"
  },
  "packageManager": "pnpm@9.4.0",
  "engines": {
    "node": ">=14.0.0"
  }
}

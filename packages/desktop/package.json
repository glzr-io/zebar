{
  "name": "@zebar/desktop",
  "version": "0.0.0",
  "scripts": {
    "build": "pnpm tauri build -- --verbose",
    "dev": "pnpm tauri dev",
    "dev:local": "pnpm dev",
    "format": "cargo fmt",
    "lint:check": "cargo clippy --all-targets --no-deps --manifest-path ./Cargo.toml",
    "lint:check:windows": "cargo clippy --target x86_64-pc-windows-msvc --all-targets --no-deps --manifest-path ./Cargo.toml",
    "lint:fix": "cargo clippy --fix --manifest-path ./Cargo.toml",
    "lint:fix:windows": "cargo clippy --fix --target x86_64-pc-windows-msvc --manifest-path ./Cargo.toml",
    "tauri": "tauri"
  },
  "dependencies": {},
  "devDependencies": {
    "@tauri-apps/cli": "2.0.3",
    "typescript": "5.3.3"
  }
}
